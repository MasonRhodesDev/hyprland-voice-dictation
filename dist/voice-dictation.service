[Unit]
Description=Voice Dictation Persistent Daemon with Integrated GUI
After=pipewire.service graphical-session.target

[Service]
Type=notify
ExecStart=/usr/bin/voice-dictation daemon
Restart=on-failure
RestartSec=5
# Exit code 64 = UI reload requested, should trigger restart
RestartForceExitStatus=64
# No WatchdogSec. A liveness heartbeat is the one thing here that cannot be
# event-driven, and this one could not detect a wedged daemon anyway: the
# keepalive was decoupled from the state machine, so it pinged regardless of
# whether the loop was turning. Restart=on-failure covers the case it did
# catch (the process dying). A genuine hang is immediately visible -- the
# hotkey does nothing -- and one restart away.
Environment="RUST_LOG=info"
Environment="GUI_LOG=info"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
